# ============================================================
# prettypleaseapprove — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ── GitHub ────────────────────────────────────────────────────
# Personal access token with repo + pull_request scopes
GITHUB_TOKEN=ghp_your_github_token_here
# Secret used to verify GitHub webhook signatures (Settings > Webhooks)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ── Groq AI ──────────────────────────────────────────────────
# Get from console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Jenkins ───────────────────────────────────────────────────
# URL where Jenkins is reachable FROM the bot backend container
JENKINS_URL=http://JENKINS_PUBLIC_IP:8080
JENKINS_USER=admin
# Generate from Jenkins > User > Configure > API Token
JENKINS_TOKEN=your_jenkins_api_token_here
# The multibranch pipeline / job name in Jenkins
JENKINS_JOB_NAME=pr-review-bot

# ── SonarQube ─────────────────────────────────────────────────
# URL reachable from bot backend (internal if same VPC)
SONAR_HOST_URL=http://SONARQUBE_PRIVATE_IP:9000
# User token from SonarQube > My Account > Security > Tokens
SONAR_TOKEN=squ_your_sonarqube_token_here
SONAR_PROJECT_KEY=pr-review-bot

# ── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgresql://botuser:botpassword@postgres:5432/botdb

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Monitoring ────────────────────────────────────────────────
GRAFANA_PASSWORD=changeme_grafana_admin_password

# ── App settings ─────────────────────────────────────────────
LOG_LEVEL=info
# Minimum coverage % — PRs below this are BLOCKED
COVERAGE_THRESHOLD=80
# Severities that trigger BLOCKED verdict in Trivy
TRIVY_BLOCK_SEVERITIES=CRITICAL,HIGH
